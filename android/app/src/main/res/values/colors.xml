<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- GeneralsX @feature Android port launcher-ui-2026 08/09/2026 Design
         tokens for the launcher (Setup / GeneralsOnline / Log Viewer /
         Folder Picker). A Material 3 dark colour-role set: one near-black
         ground, a small ladder of "surface container" tones for cards and
         rows on top of it, a primary accent for headings/active state and a
         muted pastel for destructive actions.

         GeneralsX @feature Find N5 fork 28/09/2026 Retuned from the soft
         lavender set to a military one: a dark olive ground and ladder, a
         brass/gold primary and an olive-sand secondary, so the launcher reads
         as the game it starts. Only the values changed; every colour name is
         kept, since themes.xml, UiKit and every launcher Activity refer to
         them by name.

         GeneralsZHActivity (the game surface itself) never references any of
         these — it stays on its own plain fullscreen theme. -->

    <!-- Ground + surface ladder (M3 surface container roles) -->
    <color name="gzh_background">#0F110C</color>
    <color name="gzh_surface">#14170F</color>
    <color name="gzh_surface_container_low">#171A12</color>
    <color name="gzh_surface_container">#1C1F17</color>
    <color name="gzh_surface_container_high">#242820</color>
    <color name="gzh_surface_container_highest">#2D3228</color>

    <!-- Content on those surfaces -->
    <color name="gzh_on_surface">#ECEBE4</color>
    <color name="gzh_on_surface_variant">#B3B29F</color>
    <!-- The faintest tier still has to clear WCAG AA (4.5:1) at 12sp against
         gzh_surface_container. -->
    <color name="gzh_on_surface_faint">#8E8D7C</color>
    <color name="gzh_outline">#3B4033</color>
    <color name="gzh_outline_variant">#282C22</color>

    <!-- Primary: the gold accent (headings, active nav item, selected
         segment, hero action). -->
    <color name="gzh_primary">#E2B64A</color>
    <color name="gzh_on_primary">#261B00</color>
    <color name="gzh_primary_container">#4A3A0F</color>
    <color name="gzh_on_primary_container">#FFE3A1</color>
    <!-- Kept for the themes.xml colorPrimaryDark slot (pre-API-23 status bar). -->
    <color name="gzh_primary_dark">#0F110C</color>
    <color name="gzh_accent">#E2B64A</color>

    <!-- Secondary: an olive-sand companion for tonal chips/containers. -->
    <color name="gzh_secondary">#CBC8A6</color>
    <color name="gzh_on_secondary">#303220</color>
    <color name="gzh_secondary_container">#3B3E2A</color>
    <color name="gzh_on_secondary_container">#E8E5C2</color>

    <!-- Tertiary: the muted reddish pastel used for destructive / "clear" actions. -->
    <color name="gzh_tertiary">#F3C9C6</color>
    <color name="gzh_on_tertiary">#4A2523</color>
    <color name="gzh_tertiary_container">#5C3835</color>
    <color name="gzh_on_tertiary_container">#FFDAD7</color>

    <color name="gzh_error">#FFB4AB</color>
    <color name="gzh_on_error">#690005</color>
    <color name="gzh_error_container">#93000A</color>
    <color name="gzh_on_error_container">#FFDAD6</color>

    <!-- Disabled state (M3: 38% of on-surface for content, 12% for containers) -->
    <color name="gzh_on_surface_disabled">#61ECEBE4</color>
    <color name="gzh_container_disabled">#1FECEBE4</color>
    <color name="gzh_ripple_light">#1FECEBE4</color>
    <color name="gzh_ripple_primary">#33E2B64A</color>

    <!-- GeneralsX @feature Android port game-folder-integrity-check 07/09/2026
         Semantic status colours for the game-folder validity line (see
         refreshStatus() in SetupActivity.java) — tuned for the dark ground
         above so they stay legible without shouting. -->
    <color name="gzh_status_ok">#8FD19E</color>
    <color name="gzh_status_warn">#F2C97D</color>
    <color name="gzh_status_error">#FFB4AB</color>
</resources>
